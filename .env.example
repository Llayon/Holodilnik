GEMINI_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
PORT=3001
MOCK_MODE=false
# Production vision routing (defaults: zai -> groq, no Gemini in anon chain)
# VISION_PRIMARY=zai
# VISION_FALLBACK=groq
# ZAI_TIMEOUT_MS=10000
# GROQ_TIMEOUT_MS=15000
# Set true to re-enable Groq->Gemini recipe fallback in production (default false = Groq-only prod)
# ENABLE_GEMINI_PRODUCTION_FALLBACK=false
# Anonymous prototype limits (per 24h UTC bucket)
# VISION_DEVICE_DAILY_LIMIT=5
# VISION_IP_DAILY_LIMIT=20
# RECIPE_DEVICE_DAILY_LIMIT=20
# RECIPE_IP_DAILY_LIMIT=50
# Production rate-limit store (Upstash Redis REST or Vercel KV). Dev/tests use memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
